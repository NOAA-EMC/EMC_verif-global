#!/bin/sh -e
##---------------------------------------------------------------------------
##---------------------------------------------------------------------------
## NCEP EMC GLOBAL MODEL VERIFICATION
##
## CONTRIBUTORS: Mallory Row, mallory.row@noaa.gov, NOAA/NWS/NCEP/EMC-VPPPGB
## PURPOSE: Set up configurations to run user requested verification
##---------------------------------------------------------------------------
##--------------------------------------------------------------------------

echo "BEGIN: $(basename ${BASH_SOURCE[0]})"

####################################################
# WHAT METPLUS USE CASES TO RUN
####################################################
## STEP 1 PRODUCES STATISTICS (.STAT FILES) FROM MODEL OUTPUT
## SET TO "YES" or "NO"
## EDIT SECTIONS BELOW FOR VERIFICATION TYPES REQUESTED
#RUN_GRID2GRID_STEP1: runs METplus grid_stat
#RUN_GRID2OBS_STEP1:  runs METplus point_stat
#RUN_PRECIP_STEP1:    runs METplus pcp_combine, grid_stat
#RUN_SATELLITE_STEP1: runs METplus grid_stat
export RUN_GRID2GRID_STEP1="YES"
export RUN_GRID2OBS_STEP1="NO"
export RUN_PRECIP_STEP1="NO"
export RUN_SATELLITE_STEP1="NO"

####################################################
# GENERAL SETTINGS APPLIED TO ALL USE CASES
####################################################
## INPUT DATA SETTINGS
#model_list:             model names
#model_dir_list:         directory path to model grib2 files
#model_stat_dir_list:    directory path to output model .stat files
#model_file_format_list: model file format template
#model_data_run_hpss:    get data from HPSS (YES or NO)
#model_hpss_dir_list:    HPSS directory paths for model data
#hpss_walltime:          walltime for HPSS transfer in minutes
export model_list="gfsv16"
export model_dir_list="/path/to/model/output/gfsv16"
export model_stat_dir_list="/path/to/stats/output"
export model_file_format_list="pgbf{lead?fmt=%2H}.gfs.{init?fmt=%Y%m%d%H}.grib2"
export model_data_run_hpss="NO"
export model_hpss_dir_list="/NCEPDEV/emc-naqfc/1year/$USER"
export hpss_walltime="10"
## OUTPUT DATA SETTINGS
#OUTPUTROOT: base output directory
export OUTPUTROOT="/path/to/output/$USER/verif_global_standalone_step1"
## DATE SETTINGS
#start_date:          verification start date, format YYYYMMDD
#end_date:            verification end date, format YYYYMMDD
#spinup_period_start: spinup period start, format YYYYMMDDHH, if none use "NA"
#spinup_period_end:   spinup period end, format YYYYMMDDHH, if none use "NA"
#make_met_data_by:    how to treat dates, "VALID" or "INIT"
#plot_by:             how to plot data, "VALID" or "INIT"
export start_date=20241116
export end_date=20241121
export spinup_period_start="NA"
export spinup_period_end="NA"
export make_met_data_by="VALID"
export plot_by="VALID"
## WEB SETTINGS
#SEND2WEB:    whether or not to send maps to webhost
#webhost:     webhost(rzdm) computer
#webhostid:   webhost(rzdm) user name
#webdir:      directory where to send maps on webhost
#img_quality: image quality/resolution: "low", "medium", "high"
export SEND2WEB="NO"
export webhost="emcrzdm.ncep.noaa.gov"
export webhostid="$USER"
export webdir="/home/people/emc/www/htdocs/gmb/${webhostid}/TEST"
export img_quality="low"
## METPLUS SETTINGS
#MET_version:               MET version to use: 12.0.1
#METplus_version:           METplus version to use: 6.0.0
#MET_verbosity:             MET verbosity for logging, 1-5 (most verbose is 5)
#METplus_verbosity:         DEBUG, INFO, WARN, ERROR (most verbose is DEBUG)
#log_MET_output_to_METplus: log MET output to METplus log, yes or no
export MET_version="12.0.1"
export METplus_version="6.0.0"
export METplus_verbosity="INFO"
export MET_verbosity="2"
export log_MET_output_to_METplus="yes"
## DATA DIRECTIVE SETTINGS
export SENDARCH="YES"
export KEEPDATA="YES"
export SENDECF="NO"
export SENDCOM="NO"
export SENDDBN="NO"
export SENDDBN_NTC="NO"

####################################################
# SETTINGS FOR SPECIFIC USE CASES
####################################################
if [ $RUN_GRID2GRID_STEP1 = YES ]; then
    #g2g1_type_list: list type of verifications to run for grid-to-grid: anom, pres, sfc
    #### For each type the following can be set, where [type] is anom, pres, or sfc
    #####    g2g1_[type]_truth_name:              analysis type used for verification
    #####    g2g1_[type]_truth_file_format_list:   file format template for truth/analysis
    #####    g2g1_[type]_fcyc_list:               forecast cycles to include: HH
    #####    g2g1_[type]_vhr_list:                valid hours to include: HH
    #####    g2g1_[type]_fhr_min:                 forecast hour to start verification
    #####    g2g1_[type]_fhr_max:                 forecast hour to end verification
    #####    g2g1_[type]_grid:                    NCEP grid for verification
    #####    g2g1_[type]_gather_by:               how to gather data: VALID or INIT
    export g2g1_type_list="anom pres sfc"
    export g2g1_anom_truth_name="self_anl"
    export g2g1_anom_truth_file_format_list="pgbanl.gfs.{valid?fmt=%Y%m%d%H}.grib2"
    export g2g1_anom_fcyc_list="00 06 12 18"
    export g2g1_anom_vhr_list="00 06 12 18"
    export g2g1_anom_fhr_min="0"
    export g2g1_anom_fhr_max="240"
    export g2g1_anom_grid="G002"
    export g2g1_anom_gather_by="VALID"
    export g2g1_pres_truth_name="self_anl"
    export g2g1_pres_truth_file_format_list="pgbanl.gfs.{valid?fmt=%Y%m%d%H}.grib2"
    export g2g1_pres_fcyc_list="00 06 12 18"
    export g2g1_pres_vhr_list="00 06 12 18"
    export g2g1_pres_fhr_min="0"
    export g2g1_pres_fhr_max="240"
    export g2g1_pres_grid="G002"
    export g2g1_pres_gather_by="VALID"
    export g2g1_sfc_truth_name="self_f00"
    export g2g1_sfc_truth_file_format_list="pgbf00.gfs.{valid?fmt=%Y%m%d%H}.grib2"
    export g2g1_sfc_fcyc_list="00 06 12 18"
    export g2g1_sfc_vhr_list="00 06 12 18"
    export g2g1_sfc_fhr_min="0"
    export g2g1_sfc_fhr_max="240"
    export g2g1_sfc_grid="G002"
    export g2g1_sfc_gather_by="VALID"
fi

if [ $RUN_GRID2OBS_STEP1 = YES ]; then
    #g2o1_type_list: list type of verifications to run for grid-to-obs: upper_air, conus_sfc, polar_sfc
    #### For each type the following can be set, where [type] is upper_air, conus_sfc, or polar_sfc
    #####    g2o1_[type]_msg_type_list:    observation message type(s) to be used
    #####    g2o1_[type]_fcyc_list:        forecast cycles to include: HH
    #####    g2o1_[type]_vhr_list:         valid hours to include: HH
    #####    g2o1_[type]_fhr_min:          forecast hour to start verification
    #####    g2o1_[type]_fhr_max:          forecast hour to end verification
    #####    g2o1_[type]_grid:             NCEP grid for verification
    #####    g2o1_[type]_gather_by:        how to gather data: VALID or INIT
    export g2o1_type_list="upper_air conus_sfc"
    export g2o1_upper_air_msg_type_list="ADPUPA"
    export g2o1_upper_air_fcyc_list="00 06 12 18"
    export g2o1_upper_air_vhr_list="00 06 12 18"
    export g2o1_upper_air_fhr_min="0"
    export g2o1_upper_air_fhr_max="240"
    export g2o1_upper_air_grid="G003"
    export g2o1_upper_air_gather_by="VALID"
    export g2o1_conus_sfc_msg_type_list="ONLYSF ADPUPA"
    export g2o1_conus_sfc_fcyc_list="00 06 12 18"
    export g2o1_conus_sfc_vhr_list="00 03 06 09 12 15 18 21"
    export g2o1_conus_sfc_fhr_min="0"
    export g2o1_conus_sfc_fhr_max="240"
    export g2o1_conus_sfc_grid="G104"
    export g2o1_conus_sfc_gather_by="VALID"
    export g2o1_polar_sfc_msg_type_list="IABP"
    export g2o1_polar_sfc_fcyc_list="00 06 12 18"
    export g2o1_polar_sfc_vhr_list="00 03 06 09 12 15 18 21"
    export g2o1_polar_sfc_fhr_min="0"
    export g2o1_polar_sfc_fhr_max="240"
    export g2o1_polar_sfc_grid="G219"
    export g2o1_polar_sfc_gather_by="VALID"
    export g2o1_prepbufr_data_run_hpss="NO"
fi

if [ $RUN_PRECIP_STEP1 = YES ]; then
    #precip1_type_list: precip observation type/name and accumulation length: ccpa_accum24hr
    #### For each type the following can be set, where [type] is ccpa_accum24hr
    #####    precip1_[type]_model_bucket_list:       model bucket (hours)
    #####    precip1_[type]_model_var_list:           model variable name
    #####    precip1_[type]_model_file_format_list:   model file format template
    #####    precip1_[type]_fcyc_list:                forecast cycles to include: HH
    #####    precip1_[type]_fhr_min:                  forecast hour to start verification
    #####    precip1_[type]_fhr_max:                  forecast hour to end verification
    #####    precip1_[type]_grid:                     NCEP grid for verification
    #####    precip1_[type]_gather_by:                how to gather data: VALID or INIT
    export precip1_type_list="ccpa_accum24hr"
    export precip1_ccpa_accum24hr_model_bucket_list="06"
    export precip1_ccpa_accum24hr_model_var_list="APCP"
    export precip1_ccpa_accum24hr_model_file_format_list="pgbf{lead?fmt=%2H}.gfs.{init?fmt=%Y%m%d%H}.grib2"
    export precip1_ccpa_accum24hr_fcyc_list="00 06 12 18"
    export precip1_ccpa_accum24hr_fhr_min="24"
    export precip1_ccpa_accum24hr_fhr_max="384"
    export precip1_ccpa_accum24hr_grid="G211"
    export precip1_ccpa_accum24hr_gather_by="VALID"
    export precip1_obs_data_run_hpss="NO"
fi

if [ $RUN_SATELLITE_STEP1 = YES ]; then
    #sat1_type_list: list of satellite/satellite analysis to run for:
    #                ghrsst_ncei_avhrr_anl, ghrsst_ospo_geopolar_anl
    #### For each type the following can be set, where [type] is
    ####    ghrsst_ncei_avhrr_anl or ghrsst_ospo_geopolar_anl
    #####    sat1_[type]_fcyc_list:         forecast cycles to include: HH
    #####    sat1_[type]_fhr_min:           forecast hour to start verification
    #####    sat1_[type]_fhr_max:           forecast hour to end verification
    #####    sat1_[type]_grid:              NCEP grid for verification
    #####    sat1_[type]_gather_by:         how to gather data: VALID or INIT
    #####    sat1_[type]_sea_ice_thresh:    threshold for sea ice (0 to 1)
    export sat1_type_list="ghrsst_ospo_geopolar_anl"
    export sat1_ghrsst_ncei_avhrr_anl_fcyc_list="00"
    export sat1_ghrsst_ncei_avhrr_anl_fhr_min="0"
    export sat1_ghrsst_ncei_avhrr_anl_fhr_max="240"
    export sat1_ghrsst_ncei_avhrr_anl_grid="G219"
    export sat1_ghrsst_ncei_avhrr_anl_gather_by="VALID"
    export sat1_ghrsst_ncei_avhrr_anl_sea_ice_thresh="0.15"
    export sat1_ghrsst_ospo_geopolar_anl_fcyc_list="00"
    export sat1_ghrsst_ospo_geopolar_anl_fhr_min="0"
    export sat1_ghrsst_ospo_geopolar_anl_fhr_max="240"
    export sat1_ghrsst_ospo_geopolar_anl_grid="G219"
    export sat1_ghrsst_ospo_geopolar_anl_gather_by="VALID"
    export sat1_ghrsst_ospo_geopolar_anl_sea_ice_thresh="0.15"
fi

echo "END: $(basename ${BASH_SOURCE[0]})"
